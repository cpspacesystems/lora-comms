// This file is for software simulation and hardware attached verification of the radio systems only
// ! THIS IS NOT A REAL DATA DEFINATION FOR ROCKET DATA !

#doctype !LORA_DATA_DEF-V0.1
#begin schema
    #format <poll-rate: enum>, <size: u64>, <network-type: enum>, <source-path: string-utf8>, <dest-path: string-utf8>

    #section RocketToGround
    #section GroundToRocket

    #enum poll-rate 1Hz 0.5Hz 10Hz OnChange ASAP
    #enum network-type tism zenoh
#end schema

// Data generated by TOM and sent to ground station
#begin RocketToGround

1Hz, 80, tism, tom_src1, ground_src1
1Hz, 40, tism, tom_src2, ground_src2 
1Hz, 100 , tism, tom_src3, ground_src3
1Hz, 120 , tism, tom_src4, ground_src4
1Hz, 11 , tism, tom_src5, ground_src5
0.5Hz, 200, tism, tom_slow1, ground_slow1
0.5Hz, 100, tism, tom_slow2, ground_slow2
10Hz, 8, tism, tom_fast1, ground_fast1
ASAP, 8, tism, tom_asap1, _ground_asap1
ASAP, 16, tism, tom_asap2, _ground_asap2
OnChange, 4, tism, tom_onchange1, ground_onchange1
OnChange, 100, tism, tom_onchange2, ground_onchange2

#end RocketToGround

// Data generated by ground-station/mission control and sent to TOM
#begin GroundToRocket

OnChange, 4, tism, ground_signal1, tom_signal1
OnChange, 16, tism, ground_signal2, tom_signal2 

#end GroundToRocket