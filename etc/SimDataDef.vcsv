// This file is for software simulation and hardware attached verification of the radio systems only
// ! THIS IS NOT A REAL DATA DEFINATION FOR ROCKET DATA !

#doctype !LORA_DATA_DEF-V0.1
#begin schema
    #format <poll-rate: enum>, <size: u64>, <network-type: enum>, <source-path: string-utf8>, <dest-path: string-utf8>

    #section RocketToGround
    #section GroundToRocket

    #enum poll-rate 1Hz 0.5Hz 10Hz OnChange ASAP
    #enum network-type tism zenoh
#end schema

// Data generated by TOM and sent to ground station
#begin RocketToGround

1Hz, 80, tism, tom/src1, ground/src1
1Hz, 40, tism, tom/src2, ground/src2 
1Hz, 100 , tism, tom/src3, ground/src3
1Hz, 120 , tism, tom/src4, ground/src4
1Hz, 11 , tism, tom/src5, ground/src5
0.5Hz, 200, tism, tom/slow1, ground/slow1
0.5Hz, 100, tism, tom/slow2, ground/slow2
10Hz, 8, tism, tom/fast1, ground/fast1
ASAP, 8, tism, tom/asap1, /ground/asap1
ASAP, 16, tism, tom/asap2, /ground/asap2
OnChange, 4, tism, tom/onchange1, ground/onchange1
OnChange, 100, tism, tom/onchange2, ground/onchange2

#end RocketToGround

// Data generated by ground-station/mission control and sent to TOM
#begin GroundToRocket

OnChange, 4, tism, ground/signal1, tom/signal1
OnChange, 16, tism, ground/signal2, tom/signal2 

#end GroundToRocket